<Project Sdk="Uno.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\TaskManager\TaskManager.csproj" />
    <ProjectReference Include="..\Messages\Messages.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-desktop'">
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop;net10.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>OutMapper</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>andershanell.outmapper</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>OutMapper</ApplicationPublisher>
    <!-- Package Description -->
    <Description>OutMapper powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      CSharpMarkup;
      Material;
      Toolkit;
      MVUX;
      SkiaRenderer;
      Storage;
    </UnoFeatures>
  </PropertyGroup>

</Project>
